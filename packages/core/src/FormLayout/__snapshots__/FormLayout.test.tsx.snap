// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FormLayout > matches snapshot for horizontal direction 1`] = `
<div
  class="astryx-form-layout grid grid-flow-col auto-cols-[1fr] gap-[var(--spacing-4)]"
  data-direction="horizontal"
  data-testid="layout"
>
  <input
    placeholder="First"
  />
  <input
    placeholder="Last"
  />
</div>
`;

exports[`FormLayout > matches snapshot for horizontal-labels direction 1`] = `
<div
  class="astryx-form-layout grid grid-cols-[auto_1fr] items-start gap-x-[var(--spacing-4)] gap-y-[var(--spacing-3)] max-[480px]:flex max-[480px]:flex-col max-[480px]:items-stretch max-[480px]:gap-x-[var(--spacing-4)] max-[480px]:gap-y-[var(--spacing-4)]"
  data-direction="horizontal-labels"
  data-testid="layout"
>
  <label>
    Name
  </label>
  <input
    placeholder="Name"
  />
</div>
`;

exports[`FormLayout > matches snapshot for vertical direction 1`] = `
<div
  class="astryx-form-layout flex flex-col gap-[var(--spacing-4)]"
  data-direction="vertical"
  data-testid="layout"
>
  <input
    placeholder="Name"
  />
  <input
